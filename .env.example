# Root-level variables consumed by docker-compose.yml for the local dev
# stack. Copy to .env and fill in values; never commit the real .env file.
# Backend and frontend each also have their own .env.example — see
# backend/.env.example and frontend/.env.example.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local SQL Server container (dev only)
MSSQL_SA_PASSWORD=

# Local MinIO container (dev only)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
