# Copy this file to .env and fill in real values for your environment.
# Never commit the resulting .env file.

# --- Application ---
APP_NAME=Childcare Benefit API
APP_ENV=development
DEBUG=false

# --- CORS (comma-separated list of allowed origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SQL Server ---
# Leave MSSQL_SERVER blank to run the API without a database connection
# (e.g. to exercise the health endpoint only). Required once features that
# access the database are used.
#
# MSSQL_AUTH_MODE=sql requires MSSQL_USERNAME/MSSQL_PASSWORD.
# MSSQL_AUTH_MODE=windows uses an ODBC trusted connection under the identity
# running the backend process instead (typical for a local SQL Server
# development instance reached via Windows Authentication).
#
# Leave MSSQL_PORT blank for a local named/default-instance connection over
# shared memory (e.g. MSSQL_SERVER=localhost with no port). Set it only when
# connecting to a remote server over TCP.
MSSQL_AUTH_MODE=sql
MSSQL_SERVER=
MSSQL_PORT=
MSSQL_DATABASE=
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# --- MinIO ---
# Required for claim document upload/download (POST/GET
# /claims/{claimId}/attachments...). Other endpoints work without it.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=childcare-benefit
MINIO_SECURE=true

# --- Claim document uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png

# --- Authentication (Version 1: Employee ID login) ---
# Required for /auth/login and /me to work; the app still starts and the
# health endpoint still works without it. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO
